# ---- AgriMind backend configuration (copy to .env and fill in) ----

# Folder that contains the existing AgriMind models:
#   predict_production.py (or "python predict_production.py"), predict_irrigation.py,
#   predict_price.py, predict_crop.py, scripts/predict.py, models/, *.pkl, *.csv, chatbot.py
# Empty = the repository root (the folder above backend/). On Render: /opt/render/project/src
AGRIMIND_ML_DIR=

# Database: DB_MODE = mysql | sqlite | none. Empty = mysql if DB_PASSWORD is set, otherwise
# sqlite locally (backend/data/agrimind.db) and none on Render. With none (or an unreachable
# MySQL) predictions and the assistant still work; saving, history and login are turned off.
DB_MODE=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agrimind
DB_USER=agrimind
DB_PASSWORD=

# Gemini key for the AgriMind Assistant (chatbot.py). Never put this in the frontend.
Gemini_Api_Key=

# Frontend origin(s) allowed by CORS, comma separated (any https://*.onrender.com site is also
# allowed through CORS_ORIGIN_REGEX)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leaf model (needs TensorFlow + models/plant_disease_model.keras). Without them the leaf page
# shows "Leaf model not available online yet".
LEAF_MODEL_ENABLED=true

# Load the TensorFlow leaf model at startup (slower start, faster first leaf check)
PRELOAD_LEAF_MODEL=true

# Requests per minute allowed to the assistant, per user/IP
CHAT_RATE_LIMIT_PER_MIN=12
